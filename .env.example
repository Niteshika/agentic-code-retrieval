# Copy this file to .env and fill in the values. Never commit .env.

# ---- LLM for query pre-processing: "gemini" or "openai" ----
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=minimal

# Parallel LLM calls (lower it if you hit rate limits)
LLM_WORKERS=8

# Set to false to run without the LLM (embedding-only baseline)
USE_LLM=true

# ---- Embedding model ----
# auto = GPU if available, else CPU
DEVICE=auto

# ---- Review step ----
# Parallel candidate runs (default: number of CPU cores)
REVIEW_WORKERS=
# Optional: path to a Python 2 interpreter, used for solutions that are not valid Python 3
PYTHON2_BIN=

# ---- Caches (embeddings, LLM answers, review verdicts, MTEB predictions) ----
CACHE_DIR=.cache
